<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Yol / breadcrumb cubugu -->
    <HorizontalScrollView
        android:id="@+id/scroll_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintEnd_toStartOf="@id/text_file_system_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_current_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textStyle="bold"
            tools:text="/storage/USB SanDisk" />
    </HorizontalScrollView>

    <!-- NTFS/exFAT gibi ham okuyucuyla acilan birimler icin tespit edilen
         dosya sistemi rozeti (FAT32/libaums'ta gizli, bkz. ViewModel). -->
    <TextView
        android:id="@+id/text_file_system_badge"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/scroll_path"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/scroll_path"
        tools:text="NTFS"
        tools:visibility="visible" />

    <View
        android:id="@+id/divider_path"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_path" />

    <!-- Bos durum mesaji (bagli USB yoksa) -->
    <TextView
        android:id="@+id/text_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/fm_no_device"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_path" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_files"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_path"
        tools:listitem="@layout/item_file"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/fm_title"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Alt eylem cubugu: Kopyala / Tasi / Sil / Disk Bilgisi -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_copy"
            style="?attr/materialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fm_copy"
            android:textSize="11sp"
            app:icon="@drawable/ic_folder"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_move"
            style="?attr/materialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fm_move"
            android:textSize="11sp"
            app:icon="@drawable/ic_folder"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_delete"
            style="?attr/materialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fm_delete"
            android:textSize="11sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_disk_info"
            style="?attr/materialButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fm_disk_info"
            android:textSize="11sp"
            app:icon="@drawable/ic_info"
            app:iconGravity="top" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
